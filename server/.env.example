PORT=3001
FIREBASE_PROJECT_ID=sistema-de-talentos

# Escolha UMA das opções abaixo para a credencial do Firebase Admin:
# 1) Caminho do arquivo da chave de serviço (padrão: server/serviceAccountKey.json)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# 2) Conteúdo JSON da chave em uma única linha
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# 3) Credencial padrão do Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\para\serviceAccountKey.json
